<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Markwardt.ClarityJournal.Client</RootNamespace>
    <AssemblyName>Markwardt.ClarityJournal.Client</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>embedded</DebugType>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.markwardt.clarityjournal</ApplicationId>
    <ApplicationTitle>Clarity Journal</ApplicationTitle>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Version)' != ''">
    <ReleaseNumbers>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^[0-9]+\.[0-9]+\.[0-9]+').Value)</ReleaseNumbers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ReleaseNumbers)' != ''">
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(ReleaseNumbers.Split('.')[0]), 1000000)), $([MSBuild]::Multiply($(ReleaseNumbers.Split('.')[1]), 1000)))), $(ReleaseNumbers.Split('.')[2])))</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj" GlobalPropertiesToRemove="RuntimeIdentifier" />
    <ProjectReference Include="..\Frontend\Frontend.csproj" GlobalPropertiesToRemove="RuntimeIdentifier" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Android" Version="12.1.1" />
  </ItemGroup>
</Project>
