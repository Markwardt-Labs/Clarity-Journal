<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Markwardt.ClarityJournal.Client.JournalView"
             x:CompileBindings="False">
  <Border Classes="card" Margin="20">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="44,*,44">
        <Button Grid.Column="1" Classes="dateButton" Command="{Binding ToggleListCommand}">
          <TextBlock Text="{Binding SelectedTitle}" FontWeight="Bold" FontSize="19" TextAlignment="Center" />
        </Button>
        <Panel Grid.Column="2" IsVisible="{Binding IsEntryOpen}">
          <Panel IsVisible="{Binding CanEdit}">
            <Button Classes="mic onCard" Classes.recording="{Binding Dictation.IsRecording}" Command="{Binding Dictation.Command}" IsVisible="{Binding Dictation.CanDictate}" ToolTip.Tip="{Binding Dictation.Tip}">
              <Path Classes="icon rose" Data="{StaticResource MicIconGeometry}" />
            </Button>
          </Panel>
        </Panel>
      </Grid>

      <TextBox Grid.Row="1" Classes="editor" Text="{Binding EntryText}" IsReadOnly="{Binding IsReadOnly}" IsVisible="{Binding IsEntryOpen}" PlaceholderText="What happened today? How did it feel?" VerticalAlignment="Stretch" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />

      <ScrollViewer Grid.Row="1" IsVisible="{Binding IsListOpen}" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" ScrollChanged="OnScrollChanged">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="entryRow" Classes.selected="{Binding IsSelected}" Command="{Binding Select}" Margin="0,0,0,8">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding DateLabel}" Opacity="0.65" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Heading}" IsVisible="{Binding HasHeading}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Body}" Opacity="0.8" FontSize="13" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="2" Classes="errorBar onCard" IsVisible="{Binding HasError}" Margin="0,8,0,0">
        <TextBlock Text="{Binding Error}" Classes="error" />
      </Border>
    </Grid>
  </Border>
</UserControl>
